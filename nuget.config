<?xml version="1.0" encoding="utf-8"?>

<!-- 
  To use the Avalonia CI feed to get unstable packages, move this file to the root of your solution.
-->

<configuration>
  <packageSources>
    <add key="Avalonia" value="https://www.myget.org/F/avalonia-ci/api/v2" />
	<add key="XML-Behaviors" value="https://www.myget.org/F/xamlbehaviors-nightly/api/v2" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <!-- Map packages to the appropriate package sources so central package management
       won't warn about multiple package sources (NU1507). The keys must match
       the packageSources 'key' attributes above. Any package not explicitly
       mapped will fall back to the 'nuget.org' mapping (pattern="*"). -->
  <packageSourceMapping>
    <packageSource key="Avalonia">
      <package pattern="Avalonia*" />
      <package pattern="Avalonia.*" />
      <package pattern="SkiaSharp*" />
    </packageSource>
    <packageSource key="XML-Behaviors">
      <package pattern="Xaml.Behaviors.*" />
      <package pattern="Microsoft.Xaml.Behaviors.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="Avalonia.Controls.ItemsRepeater" />
      <package pattern="FluentAvalonia.BreadcrumbBar" />
      <package pattern="Xaml.Behaviors.*" />
      <package pattern="Xaml.Behaviors.Avalonia" />
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
  <activePackageSource>
	<add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </activePackageSource>
</configuration>
