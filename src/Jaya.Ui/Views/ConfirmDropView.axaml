<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Jaya.Ui.Views.ConfirmDropView"
        Width="420" Height="160"
        CanResize="False"
        WindowStartupLocation="CenterOwner">
  <StackPanel Margin="12" Spacing="12">
    <TextBlock Name="MessageText" TextWrapping="Wrap" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button Name="CancelButton" Content="Cancel" Width="80" />
      <Button Name="OkButton" Content="OK" Width="80" />
    </StackPanel>
  </StackPanel>
</Window>
