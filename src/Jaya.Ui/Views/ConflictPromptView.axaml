<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Jaya.Ui.ViewModels"
             x:Class="Jaya.Ui.Views.ConflictPromptView">
  <UserControl.DataContext>
    <vm:ConflictPromptViewModel />
  </UserControl.DataContext>

  <StackPanel Margin="12" Spacing="8">
    <TextBlock Text="A file or folder with that name already exists."/>
    <TextBlock Text="Choose an action:"/>
    <CheckBox Content="Apply to all" IsChecked="{Binding ApplyToAll}" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button Content="Overwrite" Command="{Binding OverwriteCommand}" />
      <Button Content="Keep Both" Command="{Binding KeepBothCommand}" />
      <Button Content="Cancel" Command="{Binding CancelCommand}" />
    </StackPanel>
  </StackPanel>
</UserControl>
